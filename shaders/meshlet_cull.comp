#version 450
#extension GL_GOOGLE_include_directive : require

#include "shared_structs.h"

layout(local_size_x = 64) in;

layout(push_constant) uniform PushConstants {
  mat4 view;
  vec4 frustum;
  vec2 zNearFar;
  vec2 projectionScale;
  vec2 hzbSize;
  uint candidateCount;
  uint mode; // 0 = SingleDraw, 1 = MultiDraw
  uint meshletDrawCount;
  uint hzbMipCount;
  uint hzbEnabled;
}
pc;

layout(set = 0, binding = 0, std430) readonly buffer InstanceBuffer {
  InstanceData instances[];
};

layout(set = 0, binding = 1, std430) readonly buffer MeshletBuffer {
  Meshlet meshlets[];
};

layout(set = 0, binding = 4, std430) readonly buffer CandidateMeshletBuffer {
  MeshletInstance candidateMeshlets[];
};

layout(set = 0, binding = 5, std430) buffer VisibleMeshletBuffer {
  MeshletInstance visibleMeshlets[];
};

layout(set = 0, binding = 6, std430) buffer DrawArgumentBuffer {
  DrawIndirectCommand drawCommands[];
};

struct Counters {
  uint visibleMeshletCount;
  uint visibleTriangleCount;
};

layout(set = 0, binding = 7, std430) buffer CounterBuffer {
  Counters counters;
};

layout(set = 0, binding = 8, std430) readonly buffer MeshletDrawMetaBuffer {
  MeshletDrawMeta meshletDrawMetas[];
};

layout(set = 0, binding = 10) uniform sampler2D hzbTexture;

bool frustumCull(vec3 viewCenter, float radius) {
  const float depth = -viewCenter.z;

  // checks the left/right frustum planes
  bool visible =
      depth * pc.frustum.y - abs(viewCenter.x) * pc.frustum.x > -radius;
  // top/bottom
  visible = visible &&
            depth * pc.frustum.w - abs(viewCenter.y) * pc.frustum.z > -radius;
  // near/far
  visible = visible && depth + radius > pc.zNearFar.x &&
            depth - radius < pc.zNearFar.y;
  return visible;
}

// https://zeux.io/2023/01/12/approximate-projected-bounds/
bool projectSphere(vec3 viewCenter, float radius, out vec4 uvBounds) {
  vec3 center = vec3(viewCenter.xy, -viewCenter.z);
  if (center.z < radius + pc.zNearFar.x) {
    return false;
  }

  vec3 centerRadius = center * radius;
  float zRadiusSquared = center.z * center.z - radius * radius;
  float vx = sqrt(center.x * center.x + zRadiusSquared);
  float minX =
      (vx * center.x - centerRadius.z) / (vx * center.z + centerRadius.x);
  float maxX =
      (vx * center.x + centerRadius.z) / (vx * center.z - centerRadius.x);

  float vy = sqrt(center.y * center.y + zRadiusSquared);
  float minY =
      (vy * center.y - centerRadius.z) / (vy * center.z + centerRadius.y);
  float maxY =
      (vy * center.y + centerRadius.z) / (vy * center.z - centerRadius.y);

  vec2 ndc0 = vec2(minX * pc.projectionScale.x, minY * pc.projectionScale.y);
  vec2 ndc1 = vec2(maxX * pc.projectionScale.x, maxY * pc.projectionScale.y);
  vec2 uv0 = ndc0 * 0.5 + 0.5;
  vec2 uv1 = ndc1 * 0.5 + 0.5;
  uvBounds = vec4(min(uv0, uv1), max(uv0, uv1));
  return true;
}

bool occlusionCull(vec3 viewCenter, float radius) {
  if (pc.hzbEnabled == 0u) {
    return false;
  }

  const float depth = -viewCenter.z;
  const float nearestDepth = depth - radius;
  vec4 uvBounds;
  if (!projectSphere(viewCenter, radius, uvBounds)) {
    return false;
  }

  vec2 uvMin = clamp(uvBounds.xy, vec2(0.0), vec2(1.0));
  vec2 uvMax = clamp(uvBounds.zw, vec2(0.0), vec2(1.0));
  vec2 pixelSize = max((uvMax - uvMin) * pc.hzbSize, vec2(1.0));
  float mip = ceil(log2(max(pixelSize.x, pixelSize.y)));
  mip = clamp(mip, 0.0, float(pc.hzbMipCount - 1u));

  float hzbDepth =
      max(max(textureLod(hzbTexture, uvMin, mip).r,
              textureLod(hzbTexture, vec2(uvMax.x, uvMin.y), mip).r),
          max(textureLod(hzbTexture, vec2(uvMin.x, uvMax.y), mip).r,
              textureLod(hzbTexture, uvMax, mip).r));
  return nearestDepth > hzbDepth;
}

bool coneCull(vec3 center, float radius, vec3 coneAxis, float coneCutoff,
              vec3 cameraPosition) {
  vec3 view = center - cameraPosition;
  return dot(view, coneAxis) >= coneCutoff * length(view) + radius;
}

bool coneBackfacing(vec3 viewCenter, float worldRadius, uint boundingCone,
                    vec4 rotation) {
  vec4 cone = unpackSnorm4x8(boundingCone);
  vec3 worldAxis = normalize(rotateByQuat(cone.xyz, rotation));
  vec3 viewAxis = normalize(mat3(pc.view) * worldAxis);
  return coneCull(viewCenter, worldRadius, viewAxis, cone.w, vec3(0.0));
}

void main() {
  const uint candidateId = gl_GlobalInvocationID.x;

  if (pc.mode == 0u) {
    if (candidateId == 0) {
      drawCommands[0].vertexCount = kSyntheticIndicesPerMeshlet;
      drawCommands[0].firstVertex = 0u;
      drawCommands[0].firstInstance = 0u;
    }
  } else if (candidateId < pc.meshletDrawCount) {
    MeshletDrawMeta meta = meshletDrawMetas[candidateId];
    Meshlet drawMeshlet = meshlets[meta.meshletId];
    drawCommands[candidateId].vertexCount =
        meshletTriangleCount(drawMeshlet) * 3u;
    drawCommands[candidateId].firstVertex = 0u;
    drawCommands[candidateId].firstInstance = meta.visibleInstanceOffset;
  }

  if (candidateId >= pc.candidateCount) {
    return;
  }

  MeshletInstance candidate = candidateMeshlets[candidateId];
  InstanceData instance = instances[candidate.instanceId];
  Meshlet meshlet = meshlets[candidate.meshletId];
  vec4 boundingSphere = unpackMeshletSphere(meshlet);

  vec3 scale = vec3(instance.translationScaleX.w, instance.scaleYZ.x,
                    instance.scaleYZ.y);
  vec3 worldCenter =
      instance.translationScaleX.xyz +
      rotateByQuat(boundingSphere.xyz * scale, instance.rotation);
  float worldRadius =
      boundingSphere.w * max(max(abs(scale.x), abs(scale.y)), abs(scale.z));
  vec3 viewCenter = (pc.view * vec4(worldCenter, 1.0)).xyz;

  if (!frustumCull(viewCenter, worldRadius)) {
    return;
  }
  if (coneBackfacing(viewCenter, worldRadius, meshlet.boundingCone,
                     instance.rotation)) {
    return;
  }
  if (occlusionCull(viewCenter, worldRadius)) {
    return;
  }

  atomicAdd(counters.visibleMeshletCount, 1u);
  atomicAdd(counters.visibleTriangleCount, meshletTriangleCount(meshlet));

  uint visibleId = 0u;
  if (pc.mode == 0u) {
    visibleId = atomicAdd(drawCommands[0].instanceCount, 1u);
  } else {
    MeshletDrawMeta meta = meshletDrawMetas[candidate.meshletId];
    const uint meshletInstanceId =
        atomicAdd(drawCommands[candidate.meshletId].instanceCount, 1u);
    visibleId = meta.visibleInstanceOffset + meshletInstanceId;
  }

  visibleMeshlets[visibleId].instanceId = candidate.instanceId;
  visibleMeshlets[visibleId].meshletId = candidate.meshletId;
}
